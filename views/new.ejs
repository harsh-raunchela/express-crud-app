<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Post</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6">
    <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 w-full max-w-lg">
        
        <div class="mb-6">
            <h2 class="text-2xl font-semibold text-slate-700 mb-1">Create a new post</h2>
            <p class="text-sm text-slate-500">Share what's on your mind.</p>
        </div>

        <form method="post" action="/posts" class="flex flex-col gap-5">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                <input type="text" placeholder="e.g. johndoe" name="username" required 
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Content</label>
                <textarea rows="5" placeholder="Write your post here..." name="content" required
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition resize-none"></textarea>
            </div>
            
            <div class="flex gap-3 mt-2">
                <a href="/posts" class="px-5 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition w-full text-center text-sm font-medium">Cancel</a>
                <button class="px-5 py-2.5 rounded-lg bg-teal-500 hover:bg-teal-600 text-white transition w-full text-sm font-medium shadow-sm">Submit Post</button>
            </div>
        </form>
    </div>
</body>
</html>