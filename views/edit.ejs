<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6">
    <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 w-full max-w-lg">
        
        <div class="mb-6">
            <h2 class="text-2xl font-semibold text-slate-700 mb-1">Edit your post</h2>
            <div class="text-sm text-slate-500 flex flex-col gap-1 mt-2">
                <p>Editing as: <span class="text-teal-600 font-medium">@<%=post.username%></span></p>
                <p class="text-xs text-slate-400">ID: <%=post.id%></p>
            </div>
        </div>

        <form method="post" action="/posts/<%=post.id%>?_method=PATCH" class="flex flex-col gap-5">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Update Content</label>
                <textarea rows="6" name="content" required
                    class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition resize-none"><%=post.content%></textarea>
            </div>
            
            <div class="flex gap-3 mt-2">
                <a href="/posts" class="px-5 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition w-full text-center text-sm font-medium">Cancel</a>
                <button class="px-5 py-2.5 rounded-lg bg-teal-500 hover:bg-teal-600 text-white transition w-full text-sm font-medium shadow-sm">Save Changes</button>
            </div>
        </form>
    </div>
</body>
</html>