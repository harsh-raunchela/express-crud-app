<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- A clean, modern font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen p-6 md:p-12">
    <div class="max-w-5xl mx-auto">
        
        <!-- Header Section -->
        <div class="flex flex-col mb-10 border-b border-slate-200 pb-6">
            <div class="flex justify-between items-center">
                
                <!-- Logo & Brand Name -->
                <div class="flex items-center gap-3">
                    <div class="bg-teal-50 text-teal-600 p-2.5 rounded-xl shadow-sm border border-teal-100">
                        <!-- Book / Journal Icon -->
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-semibold text-slate-700 tracking-tight">Just<span class="text-teal-600">Jot</span></h1>
                    </div>
                </div>

                <!-- Action Button -->
                <a href="/posts/new" class="bg-teal-500 hover:bg-teal-600 text-white px-5 py-2.5 rounded-lg transition duration-200 shadow-sm text-sm font-medium flex items-center gap-2">
                    <span>+</span> New Post
                </a>
                
            </div>
            
            <!-- Tagline -->
            <p class="text-slate-500 text-sm mt-3 ml-14">A quiet space to share your thoughts.</p>
        </div>

        <!-- Grid of Post Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% for(post of posts) { %>
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition duration-200">
                    <div>
                        <h3 class="text-sm font-semibold text-teal-600 mb-3">@<%= post.username %></h3>
                        <p class="text-slate-600 leading-relaxed mb-6 whitespace-pre-wrap"><%= post.content %></p>
                    </div>
                    
                    <!-- Action Buttons -->
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100 text-sm">
                        <div class="flex gap-4">
                            <a href="/posts/<%=post.id%>" class="text-indigo-500 hover:text-indigo-700 font-medium transition">Details</a>
                            <a href="/posts/<%=post.id%>/edit" class="text-slate-500 hover:text-slate-700 font-medium transition">Edit</a>
                        </div>
                        <form method="POST" action="/posts/<%=post.id%>?_method=DELETE" class="m-0">
                            <button class="text-rose-400 hover:text-rose-600 font-medium transition">Delete</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>

    </div>
</body>
</html>