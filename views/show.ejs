<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in Detail</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen p-6 md:p-12">
    <div class="max-w-2xl mx-auto">
        
        <div class="mb-8">
            <a href="/posts" class="text-sm font-medium text-slate-500 hover:text-teal-600 transition flex items-center gap-2">
                ← Back to all posts
            </a>
        </div>

        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-slate-200">
            <div class="flex items-center justify-between border-b border-slate-100 pb-6 mb-6">
                <h3 class="text-lg font-semibold text-teal-600">@<%=post.username%></h3>
                <span class="text-xs text-slate-400 font-mono bg-slate-50 px-3 py-1 rounded-full border border-slate-100">ID: <%= post.id %></span>
            </div>
            
            <p class="text-slate-700 text-lg leading-relaxed whitespace-pre-wrap"><%=post.content%></p>
            
            <div class="flex gap-4 mt-10 pt-6 border-t border-slate-100">
                <a href="/posts/<%=post.id%>/edit" class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition">Edit Post</a>
                <form method="POST" action="/posts/<%=post.id%>?_method=DELETE" class="m-0">
                    <button class="px-5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg text-sm font-medium transition">Delete Post</button>
                </form>
            </div>
        </div>

    </div>
</body>
</html>